rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for User document
    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('createdAt' in data) || data.createdAt is string);
    }

    // Validation Blueprint for Note document
    function isValidNote(data, userId) {
      return data.keys().hasAll(['id', 'title', 'body', 'createdAt', 'updatedAt', 'userId'])
        && data.keys().hasOnly(['id', 'title', 'body', 'createdAt', 'updatedAt', 'userId', 'isPinned', 'serverUpdatedAt'])
        && data.id is string
        && isValidId(data.id)
        && data.userId == request.auth.uid
        && data.userId == userId
        && data.title is string
        && data.title.size() <= 300
        && data.body is string
        && data.body.size() <= 500000
        && data.createdAt is number
        && data.updatedAt is number
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('serverUpdatedAt' in data) || data.serverUpdatedAt is string || data.serverUpdatedAt == request.time);
    }

    // User Profile collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Users cannot be listed

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId);

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // User Notes subcollection for device synchronization
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
        allow list: if isOwner(userId) && isValidId(userId);

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(noteId)
          && incoming().id == noteId
          && isValidNote(incoming(), userId);

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(noteId)
          && isValidNote(incoming(), userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'updatedAt', 'isPinned', 'serverUpdatedAt']);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(noteId);
      }
    }
  }
}
